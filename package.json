{
  "name": "enduro-tracker",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint",
    "test": "vitest run",
    "e2e": "NUXT_BUILD_DIR=.nuxt-e2e NUXT_OUTPUT_DIR=.output-e2e nuxt build && playwright test",
    "e2e:run": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "user:create": "tsx scripts/user-create.ts",
    "vapid:generate": "node scripts/vapid-generate.mjs",
    "pwa:icons": "node scripts/pwa-icons.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "barcode-detector": "2.2.2",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "h3": "1.15.11",
    "nuxt": "^4.6.4",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^3.0.4",
    "postgres": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "web-push": "^3.6.7",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "zxing-wasm": "1.1.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^25.9.9",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "happy-dom": "^20.14.6",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  }
}
