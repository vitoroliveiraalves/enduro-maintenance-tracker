# Copy to .env for local dev, or set these in your host's environment. Placeholders only — never commit real secrets.

# Postgres connection string (docker-compose.yml runs one on port 5433 for dev).
DATABASE_URL=postgres://enduro:enduro@localhost:5433/enduro
# Long random string signing sessions (e.g. `openssl rand -base64 48`).
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the app; in production the https URL riders open (e.g. https://enduro.example.com).
BETTER_AUTH_URL=http://localhost:3010

# Header with the client IP for the auth rate limiter; the reverse proxy MUST overwrite it (nginx: proxy_set_header X-Real-IP $remote_addr;).
AUTH_IP_HEADER=x-real-ip
# Or: comma-separated proxy IPs/CIDRs, so X-Forwarded-For is trusted only past them (leave empty when using AUTH_IP_HEADER).
AUTH_TRUSTED_PROXIES=
# Sign-in / sign-up attempts per IP per window before better-auth answers 429 (default 10).
AUTH_RATE_LIMIT_MAX=10

# OpenRouter key for reading invoice lines; empty = reading off, riders type the lines (calm notice).
NUXT_OPENROUTER_API_KEY=
# Vision model used through OpenRouter.
NUXT_OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Invoice reads per user per 24 h (then 429 "Daily invoice reading limit reached…").
NUXT_INVOICE_DAILY_CAP=30
# Invoice reads for the whole server per 24 h (open registration must not multiply the per-user cap).
NUXT_INVOICE_GLOBAL_DAILY_CAP=300

# Web Push key pair from `pnpm vapid:generate`; empty = push off (Settings says so).
NUXT_VAPID_PUBLIC_KEY=
# Private half of the VAPID pair — keep it secret.
NUXT_VAPID_PRIVATE_KEY=
# Contact for push services; must be a real mailto: (Apple rejects placeholders).
NUXT_VAPID_SUBJECT=mailto:you@example.com

# Port the production server listens on (the Docker image sets 3000). Leave unset for `pnpm dev`, which uses 3010.
# PORT=3000
# `production` on deploys (the Docker image sets it; also hides dev-only routes). Leave unset locally.
# NODE_ENV=production
