# Postgres from docker-compose.yml (port 5433)
DATABASE_URL=postgres://enduro:enduro@localhost:5433/enduro
NUXT_DATABASE_URL=postgres://enduro:enduro@localhost:5433/enduro
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3010
NUXT_OPENROUTER_API_KEY=
NUXT_OPENROUTER_MODEL=google/gemini-3.1-flash-lite
NUXT_INVOICE_DAILY_CAP=30
# Rate limiter client IP. The reverse proxy MUST overwrite this header (nginx: proxy_set_header X-Real-IP $remote_addr;)
AUTH_IP_HEADER=x-real-ip
# Or: comma-separated proxy IPs/CIDRs so X-Forwarded-For is trusted only past them
AUTH_TRUSTED_PROXIES=
